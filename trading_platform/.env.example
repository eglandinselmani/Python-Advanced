# Copy to .env and adjust. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string   # leave empty to auto-generate one into data/.secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=sqlite:///data/trading.db
# auto = try live Yahoo Finance, fall back to labelled simulated data | simulated = never call the internet
MARKET_DATA_MODE=auto
BACKGROUND_WORKER=1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
API_URL=http://127.0.0.1:8000
